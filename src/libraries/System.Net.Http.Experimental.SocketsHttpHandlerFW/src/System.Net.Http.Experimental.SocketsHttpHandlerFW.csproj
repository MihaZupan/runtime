    <Compile Include="$(CommonPath)System\Net\Http\aspnetcore\IHttpStreamHeadersHandler.cs" Link="Common\System\Net\Http\aspnetcore\IHttpStreamHeadersHandler.cs" />
    <Compile Include="$(CommonPath)System\Net\Http\aspnetcore\Http2\Hpack\DynamicTable.cs" Link="Common\System\Net\Http\aspnetcore\Http2\Hpack\DynamicTable.cs" />
    <Compile Include="$(CommonPath)System\Net\Http\aspnetcore\Http2\Hpack\H2StaticTable.cs" Link="Common\System\Net\Http\aspnetcore\Http2\Hpack\H2StaticTable.cs" />
