    <Compile Include="$(LibrariesProjectRoot)System.Net.Http\src\System\Net\Http\SocketsHttpHandler\HttpAuthority.cs" Link="ProductionCode\Http\SocketsHttpHandler\HttpAuthority.cs" />
    <Compile Include="$(LibrariesProjectRoot)System.Net.Http\src\System\Net\Http\SocketsHttpHandler\HttpKeepAlivePingPolicy.cs" Link="ProductionCode\Http\SocketsHttpHandler\HttpKeepAlivePingPolicy.cs" />
    <Compile Include="$(LibrariesProjectRoot)System.Net.Http\src\System\Net\Http\SocketsHttpHandler\HttpUtilities.SocketsHttpHandler.cs" Link="ProductionCode\Http\SocketsHttpHandler\HttpUtilities.SocketsHttpHandler.cs" />
    <Compile Include="$(LibrariesProjectRoot)System.Net.Http\src\System\Net\Http\SocketsHttpHandler\IHttpTrace.cs" Link="ProductionCode\Http\SocketsHttpHandler\IHttpTrace.cs" />
